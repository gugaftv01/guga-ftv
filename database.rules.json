{
  "rules": {
    ".read": false,
    ".write": false,

    "chaveamento": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'avff5wdGl1RyJRldSsifL7SvVOa2' || auth.uid === 'gftmX0dZAkN9gXNe5Cpahlyr1lF2')"
    },

    "bola": {
      ".read": true,
      "position": {
        ".write": true,
        ".validate": "newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber()",
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false }
      },
      "$outro": { ".validate": false }
    },

    "online": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['t']) && newData.child('t').val() === now",
        "t": { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false }
      }
    },

    "acessos": {
      ".read": "auth != null && (auth.uid === 'avff5wdGl1RyJRldSsifL7SvVOa2' || auth.uid === 'gftmX0dZAkN9gXNe5Cpahlyr1lF2')",
      ".write": "auth != null && (auth.uid === 'avff5wdGl1RyJRldSsifL7SvVOa2' || auth.uid === 'gftmX0dZAkN9gXNe5Cpahlyr1lF2')",
      ".indexOn": ["quando"],
      "$id": {
        ".validate": "newData.hasChildren(['uid', 'aparelho', 'quando']) && newData.child('uid').val() === auth.uid && newData.child('quando').val() === now",
        "uid": { ".validate": "newData.isString()" },
        "aparelho": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "quando": { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false }
      }
    },

    "tentativas": {
      ".read": "auth != null && (auth.uid === 'avff5wdGl1RyJRldSsifL7SvVOa2' || auth.uid === 'gftmX0dZAkN9gXNe5Cpahlyr1lF2')",
      ".write": "auth != null && (auth.uid === 'avff5wdGl1RyJRldSsifL7SvVOa2' || auth.uid === 'gftmX0dZAkN9gXNe5Cpahlyr1lF2')",
      ".indexOn": ["quando"],
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['email', 'aparelho', 'quando']) && newData.child('quando').val() === now",
        "email": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "aparelho": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "quando": { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false }
      }
    }
  }
}
