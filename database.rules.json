{
  "rules": {
    ".read": false,
    ".write": false,

    "chaveamento": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'vitinhovenanciodesouza317@gmail.com'"
    },

    "bola": {
      ".read": true,
      "position": {
        ".write": true,
        ".validate": "newData.hasChildren(['x', 'y']) && newData.child('x').isNumber() && newData.child('y').isNumber()",
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false }
      },
      "$outro": { ".validate": false }
    },

    "tentativas": {
      ".read": "auth != null && auth.token.email === 'vitinhovenanciodesouza317@gmail.com'",
      ".write": "auth != null && auth.token.email === 'vitinhovenanciodesouza317@gmail.com'",
      ".indexOn": ["quando"],
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['email', 'aparelho', 'quando']) && newData.child('quando').val() === now",
        "email": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "aparelho": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "quando": { ".validate": "newData.isNumber()" },
        "$outro": { ".validate": false }
      }
    }
  }
}
